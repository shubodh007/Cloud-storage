# Client-safe values only. Never put service_role here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Local setup: Copy-Item .env.example .env  (then fill in the two values below)
# and run `npm run build` to generate js/supabase-config.js (gitignored).
# The browser never reads .env directly — only the build script does.
